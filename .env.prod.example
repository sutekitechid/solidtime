# Contoh env production untuk docker-compose.prod.yml.
# Cara pakai: cp .env.prod.example .env.prod  lalu isi semua nilai CHANGEME.
# File .env.prod JANGAN di-commit (berisi secret).
#
# Catatan penting:
# - DB_HOST TIDAK ditulis di sini: sudah dikunci ke `pgsql` (nama service
#   compose) di docker-compose.prod.yml. Jangan ganti ke 127.0.0.1.
# - Database + user dibuat OTOMATIS oleh service pgsql dari DB_DATABASE /
#   DB_USERNAME / DB_PASSWORD di bawah (tidak perlu CREATE DATABASE manual).
#   Ganti password HANYA sebelum volume pgdata pertama kali dibuat; setelah
#   itu harus ALTER USER manual di dalam postgres.

# === Aplikasi ===
APP_NAME=solidtime
VITE_APP_NAME=solidtime
APP_ENV=production
APP_DEBUG=false
APP_URL=https://CHANGEME.example.com
APP_FORCE_HTTPS=true
TRUSTED_PROXIES=0.0.0.0/0,2000:0:0:0:0:0:0:0/3
APP_ENABLE_REGISTRATION=invite-only
APP_KEY=CHANGEME-generate-dengan-php-artisan-key-generate---show
SUPER_ADMINS=admin@CHANGEME.example.com
PAGINATION_PER_PAGE_DEFAULT=500

# === Database (dikonsumsi service pgsql + app) ===
DB_DATABASE=solidtime
DB_USERNAME=solidtime
DB_PASSWORD=CHANGEME-min-16-karakter-acak
DB_SSL_MODE=prefer

# === Compose (dibaca docker compose dari shell, bukan oleh Laravel) ===
SOLIDTIME_IMAGE_TAG=latest
FORWARD_APP_PORT=8000
# FORWARD_DB_PORT=5432  # aktifkan hanya untuk debug, buka juga ports di compose
USER_ID=1000
GROUP_ID=1000
TZ=Asia/Jakarta
AUTO_DB_MIGRATE=true
WORKER_COMMAND=php /var/www/html/artisan queue:work database --sleep=3 --tries=3

# === Logging / cache / antrean ===
LOG_CHANNEL=stderr_daily
LOG_LEVEL=warning
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# === Mail (SMTP produksi) ===
MAIL_MAILER=smtp
MAIL_HOST=CHANGEME-smtp-host
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=CHANGEME
MAIL_PASSWORD=CHANGEME
MAIL_FROM_ADDRESS=no-reply@CHANGEME.example.com
MAIL_FROM_NAME=solidtime

# === Storage (disk lokal di volume app-storage) ===
FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DISK=local

# === Passport (WAJIB sama dengan isi tabel oauth_clients; jangan regenerate) ===
PASSPORT_PRIVATE_KEY=CHANGEME-isi-dari-laravel.env
PASSPORT_PUBLIC_KEY=CHANGEME-isi-dari-laravel.env
PASSPORT_PERSONAL_ACCESS_CLIENT_ID=CHANGEME-dari-passport-client---personal
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=CHANGEME-dari-passport-client---personal

# === Lainnya ===
GOTENBERG_URL=http://gotenberg:3000
OCTANE_SERVER=frankenphp
INERTIA_SSR_ENABLED=false
TELESCOPE_ENABLED=false
AUDITING_ENABLED=true
